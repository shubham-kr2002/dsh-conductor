{
  "name": "dsh-conductor",
  "version": "0.1.1",
  "description": "Human-control layer for autonomous coding agents in DeepSeek Harness",
  "main": "./dist/src/dsh/bundle-entry.js",
  "types": "./dist/src/index.d.ts",
  "bin": {
    "conductor": "./dist/src/cli/bin.js",
    "dsh-conductor": "./dist/src/cli/bin.js"
  },
  "type": "module",
  "scripts": {
    "build": "tsc && node scripts/copy-ui-assets.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsc && node scripts/copy-ui-assets.mjs && node --test 'dist/tests/**/*.test.js'",
    "lint": "tsc --noEmit",
    "validate:package": "node scripts/validate-package.mjs",
    "prepack": "pnpm build && node scripts/validate-package.mjs"
  },
  "keywords": [
    "dsh",
    "conductor",
    "cordis",
    "agent",
    "control-plane"
  ],
  "author": "Antigravity",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.5.1",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "commander": "^15.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/src/dsh/bundle-entry.d.ts",
      "default": "./dist/src/dsh/bundle-entry.js"
    },
    "./core": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./bundle": {
      "types": "./dist/src/dsh/bundle-entry.d.ts",
      "default": "./dist/src/dsh/bundle-entry.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/src",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2"
  }
}
