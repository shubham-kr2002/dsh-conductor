<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Conductor — attention cockpit</title>
  <link rel="stylesheet" href="/styles.css" />
</head>
<body>
  <header id="l1">
    <div class="brand">
      <span class="mark">◆</span> CONDUCTOR
      <span class="live" id="live-dot" title="event stream"></span>
    </div>
    <div class="attention-line" id="attention-line">connecting…</div>
    <div class="l1-right">
      <div class="load-chip" id="load-chip" title="attention load, with its factual basis"></div>
      <button id="btn-deleg" class="ghost slim" title="Standing delegations — what you have entrusted to the agents">Delegations (<span id="deleg-n">0</span>)</button>
      <button id="btn-away" class="ghost" title="Mark the moment you leave; the summary on return starts here">Away</button>
      <button id="btn-refresh" class="ghost" title="Re-read the control plane">↻</button>
    </div>
    <div class="budget" id="budget-line"></div>
  </header>

  <div id="deleg-pop" hidden></div>

  <main>
    <section id="needs-you" aria-label="Needs you">
      <h2 class="sec">Needs you <span id="ny-count" class="count"></span></h2>
      <div id="ny-list" class="stack"></div>
    </section>

    <section id="waiting" aria-label="Safely waiting">
      <h2 class="sec">Waiting</h2>
      <div id="offer-strip"></div>
      <div id="wt-list" class="stack"></div>
    </section>

    <section id="watching" aria-label="Watching">
      <h2 class="sec">Watching</h2>
      <div id="wc-list" class="stack"></div>
    </section>

    <section id="working" aria-label="Working">
      <div id="wk-summary" class="wk-summary" role="button" tabindex="0"></div>
      <div id="wk-list" class="stack collapsed"></div>
    </section>

    <section id="logged" aria-label="Recorded">
      <div id="lg-summary" class="lg-summary" role="button" tabindex="0"></div>
      <div id="lg-list" class="stack collapsed"></div>
    </section>
  </main>

  <div id="overlay" hidden>
    <div id="detail" role="dialog" aria-modal="true"></div>
  </div>

  <div id="toast" hidden></div>

  <script src="/app.js"></script>
</body>
</html>
